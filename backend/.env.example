# Copia a backend/.env y rellena. En producción la API no arranca si falta alguna obligatoria.
NODE_ENV=development
PORT=3000

# Supabase (Settings → API). La service role key salta RLS: solo en el backend, nunca en la app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=eur

# Firma de los QR de las entradas (obligatoria en producción). Genera una: openssl rand -hex 32
QR_SIGNING_SECRET=

# Orígenes que pueden llamar a la API, separados por comas (obligatorio en producción)
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
