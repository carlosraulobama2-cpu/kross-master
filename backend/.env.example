# Entorno
NODE_ENV=development
PORT=3000
# URL pública de la API (enlaces de recibos)
PUBLIC_API_URL=http://localhost:3000
# Orígenes permitidos por CORS, separados por comas (panel admin, web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# Solo desarrollo: usar stripe-mock en lugar de la API real de Stripe
# STRIPE_API_URL=http://localhost:12111

# Apple Wallet (opcional): pass type id, team id y certificados PEM
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=
# Google Wallet (opcional): issuer id y cuenta de servicio
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY=
